d="" class="android.widget.TextView" package="com.kasa500000.sqldpass" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,1027][1032,1594]" drawing-order="5" hint="" /><node index="5" text="DBMS(Database Management System)는 그 데이터를 저장하고 찾아 주며, 여러 사람이 동시에 수정할 때의 충돌과 접근 권한 등을 관리하는 소프트웨어입니다. SQL은 관계형 DBMS에 “이 조건에 맞는 데이터를 보여 달라” 또는 “이 값을 변경하라”고 요청하는 언어입니다. 데이터, 관리 도구, 요청 언어를 한 단어처럼 취급하지 마세요." resource-id="" class="android.widget.TextView" package="com.kasa500000.sqldpass" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,1648][1032,1701]" drawing-order="6" hint="" /><node index="6" text="네 가지를 연결해서 이해하기 · 4행 · 좌우로 이동" resource-id="" class="android.widget.TextView" package="com.kasa500000.sqldpass" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,2269][1032,1701]" drawing-order="7" hint="" /><node index="7" text="" resource-id="" class="android.widget.HorizontalScrollView" package="com.kasa500000.sqldpass" content-desc="네 가지를 연결해서 이해하기" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[48,2337][1032,1701]" drawing-order="8" hint=""><node index="0" text="" resource-id="" class="android.view.ViewGroup" package="com.kasa500000.sqldpass" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[51,2340][1032,1701]" drawing-order="1" hint=""><node 