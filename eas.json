{
  "cli": {
    "version": ">= 24.5.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_ADS_MODE": "off",
        "EXPO_PUBLIC_EXAM_ACCESS_POLICY": "launch-free"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "internal": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "internal",
        "EXPO_PUBLIC_ADS_MODE": "off",
        "EXPO_PUBLIC_EXAM_ACCESS_POLICY": "launch-free"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "simulator": {
      "extends": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_ADS_MODE": "off",
        "EXPO_PUBLIC_EXAM_ACCESS_POLICY": "launch-free",
        "ANDROID_PACKAGE": "com.kasa500000.sqldpass",
        "IOS_BUNDLE_IDENTIFIER": "com.kasa500000.sqldpass"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "ads-test": {
      "extends": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "internal",
        "EXPO_PUBLIC_ADS_MODE": "test",
        "EXPO_PUBLIC_EXAM_ACCESS_POLICY": "rewarded"
      }
    },
    "ads-test-simulator": {
      "extends": "ads-test",
      "ios": {
        "simulator": true
      }
    },
    "play-test": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "internal",
        "EXPO_PUBLIC_ADS_MODE": "test",
        "EXPO_PUBLIC_EXAM_ACCESS_POLICY": "rewarded",
        "ANDROID_PACKAGE": "com.kasa500000.sqldpass"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "play-free": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "internal",
        "EXPO_PUBLIC_ADS_MODE": "off",
        "EXPO_PUBLIC_EXAM_ACCESS_POLICY": "launch-free",
        "ANDROID_PACKAGE": "com.kasa500000.sqldpass"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "ios-free": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "internal",
        "EXPO_PUBLIC_ADS_MODE": "off",
        "EXPO_PUBLIC_EXAM_ACCESS_POLICY": "launch-free",
        "IOS_BUNDLE_IDENTIFIER": "com.kasa500000.sqldpass"
      }
    }
  },
  "submit": {
    "play-free": {
      "android": {
        "track": "alpha",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      }
    },
    "ios-free": {
      "ios": {
        "ascAppId": "6818046749",
        "ascApiKeyPath": "${EXPO_ASC_API_KEY_PATH}",
        "ascApiKeyId": "${EXPO_ASC_KEY_ID}",
        "ascApiKeyIssuerId": "${EXPO_ASC_ISSUER_ID}"
      }
    }
  }
}
