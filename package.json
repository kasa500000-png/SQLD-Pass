{
  "name":"sqld-pass","version":"0.1.0","private":true,"main":"index.ts","engines":{"node":">=22.13.0"},
  "scripts":{
    "start":"expo start --dev-client","android":"expo run:android","ios":"expo run:ios",
    "typecheck":"tsc -p tsconfig.core.json --noEmit","typecheck:native":"tsc -p tsconfig.json --noEmit",
    "test":"tsc -p tsconfig.core.json && node --test tests/*.test.cjs","doctor":"expo-doctor",
    "content:check":"node scripts/check-content.cjs","content:import":"node scripts/import-content.cjs",
    "content:materialize":"node scripts/materialize-content.cjs",
    "test:content-pipeline":"node --test tests/content-import.test.cjs",
    "ci:content":"node scripts/materialize-content.cjs --required && node scripts/check-content.cjs && node scripts/assert-draft-blocked.cjs",
    "release:check":"node scripts/check-content.cjs && node scripts/release-gate.cjs && node scripts/check-ads.cjs",
    "eas-build-pre-install":"node scripts/build-guard.cjs",
    "build:android:internal":"eas build --platform android --profile internal",
    "build:ios:simulator":"eas build --platform ios --profile simulator",
    "build:ios:internal":"eas build --platform ios --profile internal",
    "build:android:ads-test":"eas build --platform android --profile ads-test",
    "build:ios:ads-test":"eas build --platform ios --profile ads-test-simulator",
    "prebuild:android:internal":"node scripts/build-guard.cjs",
    "prebuild:ios:simulator":"node scripts/build-guard.cjs",
    "prebuild:ios:internal":"node scripts/build-guard.cjs",
    "prebuild:android:ads-test":"node scripts/build-guard.cjs",
    "prebuild:ios:ads-test":"node scripts/build-guard.cjs",
    "build:production":"npm run release:check && eas build --platform all --profile production",
    "postinstall":"node scripts/materialize-content.cjs","prestart":"node scripts/materialize-content.cjs",
    "preandroid":"node scripts/build-guard.cjs","preios":"node scripts/build-guard.cjs",
    "pretypecheck:native":"node scripts/materialize-content.cjs","pretest":"node scripts/materialize-content.cjs",
    "precontent:check":"node scripts/materialize-content.cjs --required","prerelease:check":"node scripts/materialize-content.cjs --required",
    "ads:check":"node scripts/check-ads.cjs","ads:hash":"node scripts/check-ads.cjs --hash",
    "test:monetization":"tsc -p tsconfig.core.json && node --test tests/monetization*.test.cjs"
  },
  "dependencies":{
    "expo":"57.0.18","expo-build-properties":"57.0.15","expo-crypto":"57.0.2","expo-dev-client":"57.0.16","expo-sqlite":"57.0.2","expo-status-bar":"57.0.1","react":"19.2.3","react-native":"0.86.3","react-native-safe-area-context":"5.7.0","react-native-google-mobile-ads":"16.4.0"
  },
  "devDependencies":{"@types/react":"19.2.18","@types/node":"22.20.0","typescript":"6.0.3","expo-doctor":"1.20.2","eas-cli":"22.2.0"}
}
