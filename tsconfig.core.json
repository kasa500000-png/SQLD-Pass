{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "outDir": ".build",
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src/core/**/*.ts",
    "src/ui/**/*.ts",
    "src/platform/web.ts",
    "src/monetization/**/*.ts"
  ],
  "exclude": [
    "src/platform/native.ts"
  ]
}
