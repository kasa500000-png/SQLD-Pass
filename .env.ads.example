# SQLD-Pass only. Default safe mode; no production activation in this example.
EXPO_PUBLIC_ADS_MODE=off
ADS_LIVE_APPROVED=false

# Use the ads-test / ads-test-simulator EAS profiles for official Google test ads.
# Real identifiers are supplied by the owner in their build environment after QA.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER=
EXPO_PUBLIC_ADMOB_IOS_BANNER=
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED=
EXPO_PUBLIC_ADMOB_IOS_REWARDED=

# Production also requires existing content approval and ads-release-approval.json.
# See docs/MONETIZATION_20260912.md. Never put signing keys or passwords here.
