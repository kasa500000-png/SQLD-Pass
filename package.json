{
  "name": "sqld-pass",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc -p tsconfig.core.json --noEmit",
    "typecheck:native": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.core.json && node --test tests/*.test.cjs",
    "doctor": "expo-doctor",
    "content:check": "node scripts/check-content.cjs",
    "content:import": "node scripts/import-content.cjs",
    "content:materialize": "node scripts/materialize-content.cjs",
    "test:content-pipeline": "node --test tests/content-import.test.cjs",
    "ci:content": "node scripts/materialize-content.cjs --required && node scripts/check-content.cjs && node scripts/assert-draft-blocked.cjs",
    "release:check": "node scripts/check-content.cjs && node scripts/release-gate.cjs && node scripts/check-ads.cjs",
    "eas-build-pre-install": "node scripts/build-guard.cjs",
    "build:android:internal": "npx --yes eas-cli@24.5.0 build --platform android --profile internal",
    "build:ios:simulator": "npx --yes eas-cli@24.5.0 build --platform ios --profile simulator",
    "build:ios:internal": "npx --yes eas-cli@24.5.0 build --platform ios --profile internal",
    "build:android:ads-test": "npx --yes eas-cli@24.5.0 build --platform android --profile ads-test",
    "build:ios:ads-test": "npx --yes eas-cli@24.5.0 build --platform ios --profile ads-test-simulator",
    "prebuild:android:internal": "node scripts/build-guard.cjs",
    "prebuild:ios:simulator": "node scripts/build-guard.cjs",
    "prebuild:ios:internal": "node scripts/build-guard.cjs",
    "prebuild:android:ads-test": "node scripts/build-guard.cjs",
    "prebuild:ios:ads-test": "node scripts/build-guard.cjs",
    "build:production": "npm run release:check && npx --yes eas-cli@24.5.0 build --platform all --profile production",
    "postinstall": "node scripts/materialize-content.cjs",
    "prestart": "node scripts/materialize-content.cjs",
    "preandroid": "node scripts/build-guard.cjs",
    "preios": "node scripts/build-guard.cjs",
    "pretypecheck:native": "node scripts/materialize-content.cjs",
    "pretest": "node scripts/materialize-content.cjs",
    "precontent:check": "node scripts/materialize-content.cjs --required",
    "prerelease:check": "node scripts/materialize-content.cjs --required",
    "ads:check": "node scripts/check-ads.cjs",
    "ads:hash": "node scripts/check-ads.cjs --hash",
    "test:monetization": "tsc -p tsconfig.core.json && node --test tests/monetization*.test.cjs"
  },
  "dependencies": {
    "@expo/config-plugins": "57.0.9",
    "expo": "57.0.22",
    "expo-build-properties": "57.0.17",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-font": "57.0.4",
    "expo-sqlite": "57.0.3",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-google-mobile-ads": "16.4.0",
    "react-native-safe-area-context": "5.7.0"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/react": "19.2.18",
    "expo-doctor": "1.20.2",
    "typescript": "6.0.3"
  }
}
