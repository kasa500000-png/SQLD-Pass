{
  "cli": {
    "version": ">= 24.5.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_ADS_MODE": "off",
        "EXPO_PUBLIC_EXAM_ACCESS_POLICY": "launch-free"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "internal": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "internal",
        "EXPO_PUBLIC_ADS_MODE": "off",
        "EXPO_PUBLIC_EXAM_ACCESS_POLICY": "launch-free"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "simulator": {
      "extends": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_ADS_MODE": "off",
        "EXPO_PUBLIC_EXAM_ACCESS_POLICY": "launch-free",
        "ANDROID_PACKAGE": "com.kasa500000.sqldpass",
        "IOS_BUNDLE_IDENTIFIER": "com.kasa500000.sqldpass"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "ads-test": {
      "extends": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "internal",
        "EXPO_PUBLIC_ADS_MODE": "test",
        "EXPO_PUBLIC_EXAM_ACCESS_POLICY": "rewarded"
      }
    },
    "ads-test-simulator": {
      "extends": "ads-test",
      "ios": {
        "simulator": true
      }
    },
    "play-test": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "internal",
        "EXPO_PUBLIC_ADS_MODE": "test",
        "EXPO_PUBLIC_EXAM_ACCESS_POLICY": "rewarded",
        "ANDROID_PACKAGE": "com.kasa500000.sqldpass"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "play-free": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "internal",
        "EXPO_PUBLIC_ADS_MODE": "off",
        "EXPO_PUBLIC_EXAM_ACCESS_POLICY": "launch-free",
        "ANDROID_PACKAGE": "com.kasa500000.sqldpass"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "ios-free": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "internal",
        "EXPO_PUBLIC_ADS_MODE": "off",
        "EXPO_PUBLIC_EXAM_ACCESS_POLICY": "launch-free",
        "IOS_BUNDLE_IDENTIFIER": "com.kasa500000.sqldpass"
      }
    },
    "ios-production": {
      "extends": "production",
      "autoIncrement": false
    },
    "ios-ads-production": {
      "extends": "ios-production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_ADS_MODE": "live",
        "EXPO_PUBLIC_EXAM_ACCESS_POLICY": "rewarded",
        "APP_VERSION": "0.2.0",
        "IOS_BUILD_NUMBER": "8",
        "ANDROID_PACKAGE": "com.kasa500000.sqldpass",
        "IOS_BUNDLE_IDENTIFIER": "com.kasa500000.sqldpass"
      }
    },
    "android-ads-production": {
      "extends": "production",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_ADS_MODE": "live",
        "EXPO_PUBLIC_ADS_TARGET": "android",
        "EXPO_PUBLIC_EXAM_ACCESS_POLICY": "rewarded",
        "APP_VERSION": "0.2.2",
        "ANDROID_VERSION_CODE": "15",
        "ANDROID_PACKAGE": "com.kasa500000.sqldpass",
        "IOS_BUNDLE_IDENTIFIER": "com.kasa500000.sqldpass"
      }
    },
    "textbook-ads-production": {
      "extends": "production",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_ADS_MODE": "live",
        "EXPO_PUBLIC_ADS_TARGET": "both",
        "EXPO_PUBLIC_EXAM_ACCESS_POLICY": "rewarded",
        "APP_VERSION": "0.3.2",
        "ANDROID_VERSION_CODE": "18",
        "IOS_BUILD_NUMBER": "12",
        "ANDROID_PACKAGE": "com.kasa500000.sqldpass",
        "IOS_BUNDLE_IDENTIFIER": "com.kasa500000.sqldpass"
      }
    },
    "textbook-ios-production": {
      "extends": "textbook-ads-production",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_ADS_TARGET": "ios",
        "IOS_BUILD_NUMBER": "12"
      }
    },
    "textbook-android-production": {
      "extends": "textbook-ads-production",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_ADS_TARGET": "android",
        "ANDROID_VERSION_CODE": "18",
        "APP_VERSION": "0.3.2"
      }
    }
  },
  "submit": {
    "play-free": {
      "android": {
        "track": "alpha",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      }
    },
    "ios-free": {
      "ios": {
        "ascAppId": "6818046749",
        "ascApiKeyPath": "${EXPO_ASC_API_KEY_PATH}",
        "ascApiKeyId": "${EXPO_ASC_KEY_ID}",
        "ascApiKeyIssuerId": "${EXPO_ASC_ISSUER_ID}"
      }
    },
    "ios-production": {
      "ios": {
        "ascAppId": "6818046749",
        "ascApiKeyPath": "${EXPO_ASC_API_KEY_PATH}",
        "ascApiKeyId": "${EXPO_ASC_KEY_ID}",
        "ascApiKeyIssuerId": "${EXPO_ASC_ISSUER_ID}"
      }
    },
    "ios-ads-production": {
      "extends": "ios-production"
    }
  }
}
